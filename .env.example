# The newsroom desk. Both are required — without them every admin route
# answers 503 and the public paper carries on untouched.
#
# There is deliberately no default for either. A fallback in the source is a
# published password: this repository is public.
#
# Generate a session secret with:
#   openssl rand -base64 48
#
# Set them on Vercel with:
#   vercel env add ADMIN_PASSWORD production
#   vercel env add SESSION_SECRET production

# What an editor types to sign in. At least 12 characters.
ADMIN_PASSWORD=

# Signs the admin session cookie. At least 32 characters, random, and never
# the same string as ADMIN_PASSWORD.
SESSION_SECRET=

# ── News email ─────────────────────────────────────────────────────────────
# When new stories go live, one email goes out from the paper's Gmail account.
# Server-side only; set these on Vercel, never in client code.
#
# The paper's Gmail account and a Gmail App Password for it (Google Account →
# Security → 2-Step Verification → App passwords). Sent over smtp.gmail.com.
# No quotes and no spaces: GMAIL_APP_PASSWORD=abcdefghijklmnop
GMAIL_USER=timesvalor@gmail.com
GMAIL_APP_PASSWORD=

# Comma-separated. Not committed: this repository is public and these are
# school-wide lists.
NEWS_EMAIL_RECIPIENTS=

# Shared with the GitHub Action (repository secret of the same name) that
# reports production deployments. At least 32 characters:
#   openssl rand -hex 32
NEWS_EMAIL_HOOK_SECRET=

# "1" renders the email to .cache/last-news-email.html and logs it instead of
# sending. Use it, or a recipients list of just yourself, for every test.
NEWS_EMAIL_DRY_RUN=
